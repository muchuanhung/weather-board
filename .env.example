# Discord 刪除指令：
# curl -X DELETE "$DISCORD_WEBHOOK_URL/messages/MESSAGE_ID"
DISCORD_WEBHOOK_URL=

# 保護 /api/discord/notify，避免被外人任意觸發。
# Vercel Cron 會自動帶 Authorization: Bearer $CRON_SECRET。
CRON_SECRET=

# 降雨機率門檻（0–100，預設 60）。今日或未來六小時任一超過就推播。
RAIN_CHANCE_THRESHOLD=60

# 推播訊息裡的 Demo 連結，未設定則用 https://weather-board-liart.vercel.app/
NEXT_PUBLIC_SITE_URL=

# 天氣小幫手（/api/agent）呼叫 Claude 用。未設定時改用規則依 CWA 即時天氣回答，不會壞。
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
